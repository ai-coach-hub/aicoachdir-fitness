# Required: customer-facing Pickaxe portal URL for AI Fitness Coach 2.0.
# Used after new-subscriber Terms acceptance and for direct returning-member login.
NEXT_PUBLIC_PICKAXE_FITNESS_SIGNUP_URL=https://studio.pickaxe.co/YOUR-STUDIO/YOUR-FITNESS-PORTAL

# Durable Terms acceptance database.
# The connected Neon Marketplace resource currently uses the STORAGE prefix in Vercel,
# so Vercel should inject STORAGE_URL automatically. The server also supports DATABASE_URL
# and POSTGRES_URL as fallbacks. Never expose these values with a NEXT_PUBLIC_ prefix.
STORAGE_URL=postgresql://SERVER_ONLY_CONNECTION_STRING
# Server-only Pickaxe credential used by the verified workout-history bridge.
# Set this in Vercel for Production and Preview. Never use a NEXT_PUBLIC_ prefix.
PICKAXE_WORKSPACE_API_TOKEN=

# Optional comma-separated override. The production Pickaxe portal is allowed by default.
PICKAXE_HISTORY_ALLOWED_ORIGINS=https://studio.pickaxe.co
